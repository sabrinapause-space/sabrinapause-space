        "has_children": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "The current corpus includes validated records across Japan and Taiwan, spanning temples, concert venues, fine dining rooms, commercial interiors, urban waterways, and immersive overnight stays. All records follow the same schema (JSON v1.4.1), allowing structured comparison across space types and cultural conditions.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "The current corpus includes validated records across Japan and Taiwan, spanning temples, concert venues, fine dining rooms, commercial interiors, urban waterways, and immersive overnight stays. All records follow the same schema (JSON v1.4.1), allowing structured comparison across space types and cultural conditions.",
              "href": null
            }
          ],
          "icon": null,
          "color": "default"
        },
        "archived": false
