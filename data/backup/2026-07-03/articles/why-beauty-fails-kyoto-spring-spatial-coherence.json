        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "This spring was the first time my fieldwork produced enough density within a single spatial category to expose a structural problem in my own assumptions. Until now, I had treated cultural density and perceptual recruitment as strongly correlated. Kyoto made clear they are not.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "This spring was the first time my fieldwork produced enough density within a single spatial category to expose a structural problem in my own assumptions. Until now, I had treated cultural density and perceptual recruitment as strongly correlated. Kyoto made clear they are not.",
              "href": null
            }
          ],
          "icon": null,
          "color": "default"
        },
        "archived": false
