        "last_edited_by": {
          "object": "user",
          "id": "166d872b-594c-8143-b1f3-00028c60686a"
        },
        "has_children": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "At Daigoji Temple during peak bloom, the material density was extreme: architectural heritage, seasonal timing, visual spectacle. Yet the experience never consolidated. Threshold friction, crowd pacing, and poor sequence management disrupted bodily settling before the core spatial event began. The failure was not visual. It was procedural.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "At Daigoji Temple during peak bloom, the material density was extreme: architectural heritage, seasonal timing, visual spectacle. Yet the experience never consolidated. Threshold friction, crowd pacing, and poor sequence management disrupted bodily settling before the core spatial event began. The failure was not visual. It was procedural.",
              "href": null
            }
          ],
          "icon": null,
          "color": "default"
        },
        "archived": false
      },
      {
