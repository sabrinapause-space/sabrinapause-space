        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Some of the highest-value cultural sites in the corpus failed to generate the kind of bodily alignment that supports temporal depth. Other sites, less symbolically loaded, produced far stronger perceptual coherence.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Some of the highest-value cultural sites in the corpus failed to generate the kind of bodily alignment that supports temporal depth. Other sites, less symbolically loaded, produced far stronger perceptual coherence.",
