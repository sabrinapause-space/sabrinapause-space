          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "At Daikakuji, by contrast, nothing announced itself dramatically. What emerged instead was gradual recruitment: threshold after threshold aligning light, scale, silence, and pacing until temporal awareness loosened without force.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "At Daikakuji, by contrast, nothing announced itself dramatically. What emerged instead was gradual recruitment: threshold after threshold aligning light, scale, silence, and pacing until temporal awareness loosened without force.",
              "href": null
            }
          ],
          "icon": null,
          "color": "default"
